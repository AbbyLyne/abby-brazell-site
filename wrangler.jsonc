// Tells Cloudflare how to deploy this site.
// It's a plain static site: every file in /public is served as-is, no build step.
{
  "name": "abby-brazell-site",          // Cloudflare project name (lowercase, dashes, no dots)
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
